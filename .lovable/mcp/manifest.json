    "tools": [
      {
        "name": "list_websites",
        "title": "List websites",
        "description": "List the websites managed by the signed-in user, optionally filtered by a domain/name search term or active state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Filter by domain or name substring.",
              "type": "string"
            },
            "only_active": {
              "description": "Return only active websites.",
              "type": "boolean"
            },
            "limit": {
              "description": "Maximum rows to return (default 50, max 200).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_website",
        "title": "Get website details",
        "description": "Fetch the full record for one managed website, looked up by its exact domain.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1,
              "description": "Exact domain, e.g. hn-db.fun"
            }
          },
          "required": [
            "domain"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_website",
        "title": "Add a website",
        "description": "Register a new website in the control panel for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1,
              "description": "Domain to register, e.g. example.com"
            },
            "name": {
              "description": "Display name. Defaults to the domain.",
              "type": "string"
            },
            "description": {
              "description": "Short description of the site.",
              "type": "string"
            },
            "is_active": {
              "description": "Whether the site is active (default true).",
              "type": "boolean"
            }
          },
          "required": [
            "domain"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_website",
        "title": "Update a website",
        "description": "Update the display name, description or active state of an existing website, identified by its exact domain.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1,
              "description": "Exact domain of the website to update."
            },
            "name": {
              "description": "New display name.",
              "type": "string"
            },
            "description": {
              "description": "New description.",
              "type": "string"
            },
            "is_active": {
              "description": "Activate or deactivate the website.",
              "type": "boolean"
            }
          },
          "required": [
            "domain"
          ]
        },
        "outputSchema": null
      },
      {
