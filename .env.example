# ─── Runtime ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Lovable Cloud / Supabase (required) ────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (SSR + server functions only — never expose to client)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ─── Lovable AI Gateway (optional) ──────────────────────────────────
LOVABLE_API_KEY=

# ─── Notification Center ────────────────────────────────────────────
# Shared secret used by HN-DB / HN-Cloud to push alerts into TVCC via
# POST /api/public/notifications/ingest
# Header:  x-tvcc-signature: sha256=<HMAC-SHA256(secret, raw_body)>
# Generate: openssl rand -hex 32
NOTIFICATIONS_INGEST_SECRET=

# ─── Future integrations (not used yet — leave blank) ───────────────
# HN-DB outbound API
HN_DB_API_URL=
HN_DB_API_TOKEN=

# HN-Cloud outbound API
HN_CLOUD_API_URL=
HN_CLOUD_API_TOKEN=
HN_CLOUD_WEBHOOK_SECRET=

# Generic webhook secret (for upcoming third-party integrations)
TVCC_WEBHOOK_SECRET=

# Lovable workspace integration (planned)
LOVABLE_WORKSPACE_API_URL=
LOVABLE_WORKSPACE_TOKEN=
